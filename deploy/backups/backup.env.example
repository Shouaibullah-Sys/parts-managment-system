# Config for scripts/backup-db.sh + scripts/uptime-check.sh
# Copy to ~/.diplomasi-backup.env and fill in. Never commit (holds secrets).
# The backup script sources this file automatically.

# --- Off-site copy (Cloudflare R2 via rclone) ---
# Leave R2_REMOTE unset to skip off-site upload (local dumps still happen).
R2_REMOTE=r2diplomasi
R2_BUCKET=diplomasi-backups
R2_RETAIN_DAYS=60

# --- Monitoring (healthchecks.io) ---
# Daily backup check (period 1 day, grace ~1h):
HEALTHCHECK_URL=https://hc-ping.com/REPLACE-BACKUP-UUID
# 5-minute uptime check (period 5 min, grace ~5 min):
UPTIME_HEALTHCHECK_URL=https://hc-ping.com/REPLACE-UPTIME-UUID

# --- Uptime probe target ---
PUBLIC_URL=https://diplmasiltd.net

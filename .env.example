# Diplomasi — environment template. Copy to `.env` and fill in the values:
#   cp .env.example .env
# `.env` is gitignored; NEVER commit real values.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string (Postgres.app default port is 5432).
DATABASE_URL=postgresql://diplomasi:REPLACE_STRONG_PW@127.0.0.1:5432/diplomasi
# Token signature secret — generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# ── Optional ────────────────────────────────────────────────────────────────
# Hostnames treated as the PUBLIC (read-only) view. LAN IP/hostname requests
# keep full read/write. Comma-separated, no scheme.
# NEXT_PUBLIC_REMOTE_HOSTS=diplmasiltd.net,www.diplmasiltd.net
# Legacy global kill-switch: forces read-only for every host.
# READ_ONLY=false
# Used for PDF links and other absolute URLs.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protects /api/cron/* endpoints — generate with: openssl rand -hex 32
# CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Web push notifications (bell icon). Generate a VAPID pair, e.g.:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# SMS alerts via Twilio (leave empty to disable SMS).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# App port (standalone server; default 3000).
# PORT=3000
